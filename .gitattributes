# Normalize to LF in the repository AND the working tree.
#
# `text=auto` alone stores LF but still checks out CRLF where core.autocrlf is true, so two
# copies of the same file can differ byte-for-byte depending on who cloned them. Any tool
# that parses these files — a heading regex, a byte-stable golden comparison, a checksum —
# then behaves differently per machine. Forcing eol=lf removes the difference.
* text=auto eol=lf

# Shell scripts must keep LF; a CRLF shebang fails on Linux and WSL.
*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only scripts must keep CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never guess at binary content.
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Lockfiles are LF regardless of platform.
package-lock.json  text eol=lf
pnpm-lock.yaml     text eol=lf
yarn.lock          text eol=lf
poetry.lock        text eol=lf
Cargo.lock         text eol=lf
